# --- Server ---
PORT=4100
# 127.0.0.1 when everything runs on one server. 0.0.0.0 only behind nginx with an IP allowlist.
BIND_HOST=127.0.0.1
DATABASE_URL=postgresql://lumiere:CHANGE_ME@127.0.0.1:5432/lumiere
AUTO_MIGRATE=true

# --- Brand (the name/domain may change later: nothing is hardcoded) ---
SITE_NAME=لومیر
SITE_URL=https://lumiere.nexcart.ir
# Added to outgoing links to seller stores as utm_source (shows up in the seller's own analytics)
UTM_SOURCE=lumiere

# --- NexCart feed (existing HMAC contract) ---
# Same server: loopback. Separate server: https://api.nexcart.ir/api/lumiere/sync
NEXCART_FEED_URL=http://127.0.0.1:4000/api/lumiere/sync
# Same value as LUMIERE_SYNC_SECRET in nexcart-api (used in both directions)
LUMIERE_SYNC_SECRET=CHANGE_ME_LONG_RANDOM
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
# A shop needs at least this many displayable products to be shown
MIN_SHOP_PRODUCTS=3

# Salt for hashing visitor IPs in click records
HASH_SALT=CHANGE_ME
